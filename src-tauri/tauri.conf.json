{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhraseShelf",
  "version": "0.5.0",
  "identifier": "app.phraseshelf",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhraseShelf",
        "width": 900,
        "height": 620,
        "minWidth": 420,
        "minHeight": 300,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mj-fuzz",
    "shortDescription": "Tabbed quick-copy clipboard",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
