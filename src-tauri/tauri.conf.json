{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhraseShelf",
  "version": "0.6.0",
  "identifier": "app.phraseshelf",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PhraseShelf",
        "width": 900,
        "height": 620,
        "minWidth": 420,
        "minHeight": 300,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mj-fuzz",
    "shortDescription": "Tabbed quick-copy clipboard",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "French", "Spanish", "PortugueseBR", "Korean", "Japanese"],
        "displayLanguageSelector": true
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMTc5NENFMkU0RjcxMzEKUldReGNVOHV6cFFYYnExL1BtOHpJSVhidlBadUVpb3pvczh4M3NkWW56NXNZYkI5aFBTUlN4RS8K",
      "endpoints": [
        "https://github.com/phraseshelf/phraseshelf/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
